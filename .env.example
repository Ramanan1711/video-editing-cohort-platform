# Supabase Configuration (Required)
# Retrieve from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional: Sentry Error Telemetry (Leave blank to use local error buffer)
VITE_SENTRY_DSN=

# Razorpay Configuration (Public Key ID for client checkout modal)
# e.g. rzp_test_XXXXXXXXXXXXXXXX or rzp_live_XXXXXXXXXXXXXXXX
VITE_RAZORPAY_KEY_ID=
# Optional safety override: set to 'true' only to allow rzp_test_... keys in production/staging builds
# VITE_ALLOW_TEST_PAYMENTS_IN_PROD=true

# Server-Side Secrets (Configured ONLY in Supabase Secrets / Edge Functions - DO NOT put in frontend .env)
# Set via Supabase CLI: supabase secrets set RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=... ALLOWED_ORIGINS=...

# Edge Functions CORS Allowed Origins (Comma-separated)
# Automatically enables CORS for your custom production domains and staging URLs
ALLOWED_ORIGINS=https://iunoware.com,https://academy.iunoware.com,https://platform.iunoware.com,https://video-editing-cohort-platform.vercel.app,https://e-tech.iunoware.tech

# WhatsApp Academy Support & Batch Group Integration
# Real WhatsApp Business/support number with country code (e.g. 919080995108)
VITE_WHATSAPP_SUPPORT_PHONE=919080995108
# Provider mode: 'manual' (direct wa.me click-to-chat, zero cost/API setup), 'meta', 'twilio', or 'webhook'
VITE_WHATSAPP_PROVIDER=manual
# Default or fallback WhatsApp cohort invite link
VITE_WHATSAPP_GROUP_FALLBACK_URL=https://chat.whatsapp.com/G7tEsqF5Mq1FzLzZHlpHjz?mode=gi_t
# Supabase Configuration (Required)
# Retrieve from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional: Sentry Error Telemetry (Leave blank to use local error buffer)
VITE_SENTRY_DSN=

# Razorpay Configuration (Public Key ID for client checkout modal)
# e.g. rzp_test_XXXXXXXXXXXXXXXX or rzp_live_XXXXXXXXXXXXXXXX
VITE_RAZORPAY_KEY_ID=

# Server-Side Secrets (Configured in Supabase Vault / Edge Functions)
# Upload to Supabase using: supabase secrets set RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Academy Support & Batch Group Integration
# Real WhatsApp Business/support number with country code (e.g. 919080995108)
VITE_WHATSAPP_SUPPORT_PHONE=919080995108
# Provider mode: 'manual' (direct wa.me click-to-chat, zero cost/API setup), 'meta', 'twilio', or 'webhook'
VITE_WHATSAPP_PROVIDER=manual
# Default or fallback WhatsApp cohort invite link
VITE_WHATSAPP_GROUP_FALLBACK_URL=https://chat.whatsapp.com/invite